# Supabase loyiha sozlamalari (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Faqat serverda ishlatiladi (admin yozish uchun). Hech qachon frontendga chiqarmang!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Saytning to'liq manzili (sitemap, OG, canonical uchun)
NEXT_PUBLIC_SITE_URL=https://empiregroup.uz

# Telegram bot (lead bildirishnomasi uchun)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-100123456789

# Google Analytics va Ads (ixtiyoriy)
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GADS_CONVERSION_ID=AW-XXXXXXXXX/AbC-dEf123
